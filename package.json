{
  "name": "katalk-relationship-analyzer",
  "version": "1.0.0",
  "description": "카카오톡 대화 내보내기 txt 파일을 분석하여 관계 리포트를 제공하는 웹 서비스",
  "private": true,
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "build:client": "cd client && npm run build",
    "build": "npm run install:all && npm run build:client",
    "start": "node server/server.js",
    "dev:server": "node server/server.js",
    "test": "cd server && npx jest --config ../jest.config.js",
    "test:unit": "cd server && npx jest --config ../jest.config.js --testPathPattern=tests/unit",
    "test:property": "cd server && npx jest --config ../jest.config.js --testPathPattern=tests/property",
    "test:integration": "cd server && npx jest --config ../jest.config.js --testPathPattern=tests/integration"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED"
}
